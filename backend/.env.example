# 当前阶段：1=单机闭环  2=双节点联邦  3=自动握手+防刷全开
PHASE=1

PORT=3000

# 本节点对外地址（好友推送要能连到）
SELF_SERVER_URL=https://moments.example.com
SELF_NODE_ID=alice_node
SELF_DISPLAY_NAME=Alice的小镇

# 本机默认身份（发动态未指定时用）
SELF_HUMAN_ID=alice_human
SELF_HUMAN_NAME=Alice
SELF_AI_ID=xiaoa_ai
SELF_AI_NAME=XiaoA

DB_PATH=./data/moments.db

# 防重放时间窗（秒）
SIGNATURE_WINDOW_SECONDS=300

# 加好友限流：同一来源每小时最多几次
FRIEND_REQUEST_RATE_LIMIT=5

# 同一动态上 identity↔identity 最多往返几轮评论
MAX_EXCHANGE_ROUNDS=2

# 握手 token 有效期（秒）
HANDSHAKE_TOKEN_TTL_SECONDS=600

# ── 前端管理通道 /api/admin/* ────────────────────────────────
# 前端（手机 App / 浏览器）凭它加好友、审批申请，不用再 SSH 上 VPS。
# 留空则该通道整体 503。生成：openssl rand -hex 32
# 这是长期凭据，等价于账号密码：必须走 HTTPS，不要进 git，不要在聊天里贴。
ADMIN_TOKEN=

# 每 IP 每小时最多几次 admin 请求（防爆破）。前端要轮询待审列表，别调太低
ADMIN_RATE_LIMIT=600

# 允许跨域调 admin 口的前端来源，逗号分隔。
# Capacitor App 的 Origin 随 androidScheme 变（https://localhost / capacitor://localhost /
# file:// 都可能），拿不准就填 * —— 鉴权靠 ADMIN_TOKEN，CORS 只是纵深防御。
# 注意：nginx 侧不要再 add_header Access-Control-Allow-Origin，
# 两份 ACAO 会让浏览器直接判 CORS 失败
ADMIN_CORS_ORIGINS=*
