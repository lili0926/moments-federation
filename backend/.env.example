# 当前阶段：1=单机闭环  2=双节点联邦  3=自动握手+防刷全开
PHASE=1

PORT=3000

# 本节点对外地址（好友推送要能连到）
SELF_SERVER_URL=https://moments.example.com
SELF_NODE_ID=alice_node
SELF_DISPLAY_NAME=Alice的小镇

# 本机默认身份（发动态未指定时用）
SELF_HUMAN_ID=alice_human
SELF_HUMAN_NAME=Alice
SELF_AI_ID=xiaoa_ai
SELF_AI_NAME=XiaoA

DB_PATH=./data/moments.db

# 防重放时间窗（秒）
SIGNATURE_WINDOW_SECONDS=300

# 加好友限流：同一来源每小时最多几次
FRIEND_REQUEST_RATE_LIMIT=5

# 同一动态上 identity↔identity 最多往返几轮评论
MAX_EXCHANGE_ROUNDS=2

# 握手 token 有效期（秒）
HANDSHAKE_TOKEN_TTL_SECONDS=600
